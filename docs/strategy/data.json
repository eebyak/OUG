      "Reduced Year 0 OPEX to pre-launch only",
      "Added explicit personnel scaling rules",
      "Added hub costs for academic coordination",
      "Improved second program boost documentation",
      "Added sensitivity scenarios"
    ]
  },
  
  "assumptions": {
    "growth": {
      "start_students_year_1": 400,
      "annual_growth_rate": 0.10,
      "second_program_launch_year": 3,
      "second_program_growth_boost": 0.25,
      "second_program_boost_description": "One-time 25% boost applied only in Year 3",
      "microcredential_start_year_1": 200,
      "microcredential_growth_rate": 0.15,
      "ects_per_degree_student": 30,
      "ects_per_microcredential": 5,
      "dropout_rate": 0.20,
      "new_hubs": [
        {"year": 3, "count": 1, "cost_per_hub": 32500, "description": "First new academic hub"},
        {"year": 5, "count": 1, "cost_per_hub": 32500, "description": "Second academic hub"}
      ]
    },
    
    "pricing": {
      "price_per_ects": 20,
