      "state_funding_start_year": 5,
      "state_funding_per_student": 1500,
      "drittmittel_per_year": 200000,
      "drittmittel_start_year": 3,
      "sponsorship_per_year": 100000,
      "sponsorship_start_year": 3,
      "revenue_notes": "Drittmittel and sponsorship are project-based, not for core operations"
    },
    
    "partner_payouts": {
      "partner_share": 0.60,
      "oug_overhead": 0.40,
      "payment_timing": "after_completion",
      "dropout_adjustment": true,
      "dropout_note": "Partners paid only for completed ECTS (80% of sold)"
    },
    
    "personnel": {
      "base_team": [
        {"position": "President", "tarif": "Besoldung", "vza": 1, "annual_cost": 120000, "category": "executive"},
        {"position": "Dean", "tarif": "Besoldung", "vza": 1, "annual_cost": 100000, "category": "executive"},
        {"position": "Chancellor", "tarif": "Besoldung", "vza": 1, "annual_cost": 100000, "category": "executive"},
        {"position": "Akademische Leitung", "tarif": "E13", "vza": 1, "annual_cost": 65000, "category": "academic"},
        {"position": "Partner Management", "tarif": "E13", "vza": 1, "annual_cost": 65000, "category": "operations"},
        {"position": "Recht/Compliance", "tarif": "E13", "vza": 1, "annual_cost": 65000, "category": "legal"},
        {"position": "Marketing", "tarif": "E13", "vza": 1, "annual_cost": 65000, "category": "marketing"},
        {"position": "Verwaltung", "tarif": "E6", "vza": 2, "annual_cost": 75000, "category": "admin"},
        {"position": "Technik", "tarif": "E11", "vza": 2, "annual_cost": 110000, "category": "it"}
      ],
      "base_team_total": 765000,
      "scaling_rules": [
        {
          "threshold_students": 1500,
          "year_expected": 6,
          "add_positions": [
            {"position": "Verwaltung", "tarif": "E6", "vza": 1, "annual_cost": 37500, "category": "admin"},
            {"position": "Student Support", "tarif": "E9", "vza": 1, "annual_cost": 45000, "category": "student_services"}
          ],
          "total_addition": 82500
        },
        {
          "threshold_students": 2500,
          "year_expected": 9,
          "add_positions": [
            {"position": "IT Support", "tarif": "E11", "vza": 1, "annual_cost": 55000, "category": "it"},
            {"position": "Partner Management", "tarif": "E13", "vza": 1, "annual_cost": 65000, "category": "operations"}
          ],
          "total_addition": 120000
        }
      ],
      "hub_costs": {
        "per_hub_addition": 32500,
        "description": "Academic coordination for each new hub (0.5 E13)"
      }
    },
    
    "opex": {
      "base_year_1": 720000,
      "year_0_prelaunch": 200000,
      "description": "Year 0 includes only essential pre-launch costs (legal, IT setup, minimal operations)",
      "categories": [
        {
          "name": "IT & Digital",
          "base_cost": 140000,
          "items": [
            {"name": "Server/Hosting", "cost": 50000, "scaling": "per_10k_ects", "scaling_rate": 0.10, "description": "Scales with ECTS volume"},
            {"name": "LMS maintenance", "cost": 30000, "scaling": "fixed", "description": "Community edition + support"},
            {"name": "ECTS tracking system", "cost": 40000, "scaling": "fixed", "description": "Built in CAPEX, then maintenance"},
            {"name": "IT security audits", "cost": 20000, "scaling": "fixed", "description": "Annual requirement"}
          ]
        },
        {
          "name": "Governance & QA",
          "base_cost": 170000,
          "items": [
            {"name": "Senate/Board expenses", "cost": 50000, "scaling": "fixed", "description": "Reisekosten, Aufwandsentschädigungen"},
            {"name": "Accreditation maintenance", "cost": 80000, "scaling": "fixed", "description": "Periodic reviews"},
            {"name": "Quality audits", "cost": 40000, "scaling": "fixed", "description": "External reviewers"}
          ]
        },
        {
          "name": "Student Services",
          "base_cost": 230000,
          "items": [
            {"name": "Studienberatung", "cost": 130000, "scaling": "per_1500_students", "increment": 65000, "description": "+1 advisor at 1500 students"},
            {"name": "Prüfungskoordination", "cost": 60000, "scaling": "per_ects_volume", "description": "Scales with exam volume"},
            {"name": "Barrierefreiheit", "cost": 40000, "scaling": "fixed", "description": "Accessibility monitoring"}
          ]
        },
        {
          "name": "Partner Operations",
          "base_cost": 100000,
          "items": [
            {"name": "Partner support", "cost": 60000, "scaling": "per_partner", "description": "Scales with number of partner universities"},
            {"name": "Vertragsmanagement", "cost": 40000, "scaling": "fixed", "description": "Contract administration"}
          ]
        },
        {
          "name": "Facilities",
          "base_cost": 80000,
          "items": [
            {"name": "Office rent", "cost": 60000, "scaling": "fixed_until_50_staff", "description": "Small Berlin office"},
            {"name": "Energie/Reinigung", "cost": 20000, "scaling": "fixed", "description": "Utilities and cleaning"}
          ]
        }
      ],
      "scaling_notes": "Most OPEX fixed until >2000 students; gradual scaling thereafter"
    },
    
    "marketing": {
      "budget_by_year": [
        {"year": 0, "budget": 200000, "phase": "Pre-launch awareness"},
        {"year": 1, "budget": 300000, "phase": "Aggressive acquisition"},
