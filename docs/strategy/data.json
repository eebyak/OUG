    "capex": {
      "total": 4100000,
      "blocks": [
        {
          "name": "A: Accreditation & Legal",
          "total": 1900000,
          "spend_by_year": [
            {"year": 0, "amount": 1000000, "items": ["Institutional accreditation prep", "Legal framework", "KMK coordination"]},
            {"year": 1, "amount": 900000, "items": ["Programme accreditation (2 programs)", "Final legal codification"]},
            {"year": 2, "amount": 0}
          ]
        },
        {
          "name": "B: Quality & Governance Setup",
          "total": 950000,
          "spend_by_year": [
            {"year": 0, "amount": 500000, "items": ["QA system design", "Governance architecture"]},
            {"year": 1, "amount": 450000, "items": ["Implementation", "Mock reviews", "Board setup"]},
            {"year": 2, "amount": 0}
          ]
        },
        {
          "name": "C: Digital Platform & Launch",
          "total": 1250000,
          "spend_by_year": [
            {"year": 0, "amount": 800000, "items": ["Platform architecture", "ECTS tracking system build", "Security setup"]},
            {"year": 1, "amount": 450000, "items": ["Branding", "Launch campaign", "User testing"]},
            {"year": 2, "amount": 0}
          ]
        }
      ],
      "amortization_years": 5,
      "annual_amortization": 820000,
      "description": "One-time setup costs, amortized over 5 years for accounting purposes"
    },
    
    "scenarios": {
      "conservative": {
