  "narrative": {
    "executive_summary": "The Open University of Germany requires €4.1 million in start-up capital (CAPEX) plus approximately €3 million in operating support over the first four years, for a total funding need of €7.1 million. By Year 8, the institution reaches operational break-even, and by Year 10 serves over 1,800 learners (degree + micro) at a cost per student of €2,250—significantly below the €8,000-10,000 typical of traditional universities.",
    
    "the_ask": {
      "total": 7100000,
      "capex": 4100000,
      "operating_support": 3000000,
      "years": "0-4",
      "description": "One-time investment to establish a permanent, scalable infrastructure for lifelong learning in Germany"
    },
    
    "key_metrics_table": {
      "Students reached by Year 5": "1,082 (degree + micro)",
      "Students reached by Year 10": "1,883 (degree + micro)",
      "ECTS delivered by Year 5": "23,711",
      "Partner payouts cumulative by Year 5": "€883,000",
      "Partner payouts cumulative by Year 10": "€2.4M",
      "Break-even (operational)": "Year 8",
      "Break-even (cumulative cash)": "Year 13+",
      "Cost per student at scale (Year 10)": "€2,250"
    },
    
    "efficiency_arguments": [
      {
        "title": "No duplication of faculty",
        "description": "We pay partners 60% of tuition to use their existing teaching capacity—no new professors needed"
      },
      {
        "title": "Lean central team",
        "description": "11 people support 1,000+ students through automation and open source infrastructure"
      },
      {
        "title": "Open source infrastructure",
        "description": "No expensive software licenses; community-driven development keeps costs low"
      },
      {
        "title": "Scaling leverage",
        "description": "OPEX grows at 3-5% annually while students grow at 10%"
      },
      {
        "title": "Partner payout efficiency",
        "description": "60% of tuition returns to public universities, strengthening the entire system"
      }
    ],
    
    "strategic_case": {
      "problem": "Private Fernhochschulen already enroll hundreds of thousands of students who cannot access public universities. These students pay €2,000-4,000 per year for education that should be a public good.",
      "solution": "With €7.1M public investment, the OUG offers quality-assured, stackable credentials at €600/semester—1/3 to 1/6 the cost of private alternatives.",
      "impact": [
        "Create a federal infrastructure for lifelong learning",
        "Return 60% of tuition to public universities",
        "Build a national brand for open, flexible higher education",
        "Reach learners traditional universities cannot serve: Berufstätige, Pflegende, Menschen in Lebensumbrüchen",
        "Demonstrate German leadership in educational innovation"
      ]
    },
    
    "risk_mitigation": [
      {
        "risk": "Slower than expected growth",
        "mitigation": "Lean cost structure means even at 8% growth, model remains viable; marketing can be adjusted"
      },
      {
        "risk": "Partner university participation",
        "mitigation": "60% payout creates strong incentive; low-risk entry for partners (no capacity commitment)"
      },
      {
        "risk": "Political/Länder coordination",
        "mitigation": "Model designed to fit within existing LHG-Logiken; state funding only begins Year 5"
      },
      {
        "risk": "Technology failure",
        "mitigation": "Open source, modular architecture; core ECTS tracking built in CAPEX Phase 0"
      }
    ]
  },
  
